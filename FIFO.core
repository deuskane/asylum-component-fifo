CAPI=2:

#-----------------------------------------------------------------------------
# Title      : FIFO Core file
# Project    : Asylum
#-----------------------------------------------------------------------------
# File       : FIFO.core
# Author     : mrosiere
#-----------------------------------------------------------------------------
# Description: 
#-----------------------------------------------------------------------------
# Copyright (c) 2025
#-----------------------------------------------------------------------------
# Revisions  :
# Date        Version  Author   Description
# 2025-07-05  1.0.0    mrosiere First Release
# 2025-07-28  1.1.0    mrosiere Add flags full/empty in each side
# 2025-09-06  1.1.1    mrosiere Update depends
# 2026-06-10  1.2.0    mrosiere Add SYNC_READ and tb
# 2026-10-05  1.2.1    mrosiere Fix SYNC_READ push+pop with one word stored
#                               Skip nb_elt assertion before reset
#                               Fix empty/full flags with DEPTH=1
#                               Add simultaneous push/pop tests
#                               Rename lint target to lint_ghdl
#-----------------------------------------------------------------------------

name        : asylum:component:fifo:1.2.1
description : FIFO Module

#=========================================
filesets:
#=========================================

  #---------------------------------------
  hdl:
  #---------------------------------------
    files        :
      - hdl/fifo_pkg.vhd
      - hdl/fifo_sync.vhd
    file_type    : vhdlSource
    logical_name : asylum
    depend       :
      - asylum:utils:pkg
      - asylum:component:ram

  #---------------------------------------
  sim_basic:
  #---------------------------------------
    files        :
      - sim/fifo_sync_tb.vhd
    file_type    : vhdlSource-2008
    #logical_name : asylum
    depend       :
      - bitvis:verification:uvvm   

  #---------------------------------------
  # Lint / synthesis check : ghdl_synth.sh / ghdl_synth.mk (pre_run hook
  # of lint_ghdl_synth_*), copy of tools/ghdl of asylum:utils:generators :
  # no dependency to generators (cycle generators -> fifo -> ram -> pkg)
  #---------------------------------------
  syn:
    files        :
      - syn/ghdl/ghdl_synth.sh : {file_type : user, copyto : ghdl_synth.sh}
      - syn/ghdl/ghdl_synth.mk : {file_type : user, copyto : ghdl_synth.mk}

#=========================================
targets:
#=========================================

  #---------------------------------------
  default: &default
  #---------------------------------------
    description     : Default Target
    filesets        :
      - hdl

  #---------------------------------------
  lint_ghdl : &lint_ghdl
  #---------------------------------------
    << : *default
    description     : Lint with GHDL (-Wall analysis and elaboration of fifo_sync)
    toplevel        : asylum.fifo_sync
    filesets_append : [syn]
    default_tool    : ghdl
    tools :
      ghdl :
        analyze_options : ["-Wall","-Werror"]

  #---------------------------------------
  # Synthesis check : -Wall analysis, ghdl --synth -Wall and elaboration
  # (no simulation) of fifo_sync with the generics of the target.
  # The pre_run hook (syn/ghdl/ghdl_synth.sh) adds syn/ghdl/ghdl_synth.mk
  # to the edalize Makefile.
  # FuseSoC merges tools in depth : analyze_options comes from lint_ghdl.
  #---------------------------------------
  lint_ghdl_synth_default : &lint_ghdl_synth
    << : *lint_ghdl
    description     : Synthesis check of fifo_sync, default generics
    tools :
      ghdl :
        run_options     : ["--no-run"]
    hooks :
      pre_run : [ghdl_synth]

  #---------------------------------------
  lint_ghdl_synth_depth1_read_async :
  #---------------------------------------
    << : *lint_ghdl_synth
    description     : Synthesis check of fifo_sync, DEPTH 1, asynchronous read
    parameters      :
      - DEPTH=1

  #---------------------------------------
  lint_ghdl_synth_depth1_read_sync :
  #---------------------------------------
    << : *lint_ghdl_synth
    description     : Synthesis check of fifo_sync, DEPTH 1, synchronous read
    parameters      :
      - DEPTH=1
      - SYNC_READ=true

  #---------------------------------------
  lint_ghdl_synth_depth8_read_async :
  #---------------------------------------
    << : *lint_ghdl_synth
    description     : Synthesis check of fifo_sync, DEPTH 8, asynchronous read
    parameters      :
      - DEPTH=8

  #---------------------------------------
  lint_ghdl_synth_depth8_read_sync :
  #---------------------------------------
    << : *lint_ghdl_synth
    description     : Synthesis check of fifo_sync, DEPTH 8, synchronous read
    parameters      :
      - DEPTH=8
      - SYNC_READ=true

  #---------------------------------------
  sim_fifo_depth8_read_async:
  #---------------------------------------
    << : *default
    description     : Simulation of basic unit tests with Synchronous FIFO and Asynchronous RAM
    filesets_append :
      - sim_basic
    toplevel        : fifo_sync_tb
    parameters      :
      - SYNC_READ=false
      - DEPTH=8
    default_tool    : ghdl
    tools :
      ghdl :
        analyze_options : ["-Wall","-fsynopsys","-frelaxed","--no-vital-checks"]
        run_options     : ["--fst=dut.fst","--ieee-asserts=disable"]

        
  #---------------------------------------
  sim_fifo_depth8_read_sync:
  #---------------------------------------
    << : *default
    description     : Simulation of basic unit tests with Synchronous FIFO and Synchronous RAM
    filesets_append :
      - sim_basic
    toplevel        : fifo_sync_tb
    parameters      :
      - SYNC_READ=true
      - DEPTH=8
    default_tool    : ghdl
    tools :
      ghdl :
        analyze_options : ["-Wall","-fsynopsys","-frelaxed","--no-vital-checks"]
        run_options     : ["--fst=dut.fst","--ieee-asserts=disable"]

  #---------------------------------------
  sim_fifo_depth1_read_async:
  #---------------------------------------
    << : *default
    description     : Simulation of basic unit tests with DEPTH=1 and Asynchronous RAM
    filesets_append :
      - sim_basic
    toplevel        : fifo_sync_tb
    parameters      :
      - SYNC_READ=false
      - DEPTH=1
    default_tool    : ghdl
    tools :
      ghdl :
        analyze_options : ["-Wall","-fsynopsys","-frelaxed","--no-vital-checks"]
        run_options     : ["--fst=dut.fst","--ieee-asserts=disable"]

  #---------------------------------------
  sim_fifo_depth1_read_sync:
  #---------------------------------------
    << : *default
    description     : Simulation of basic unit tests with DEPTH=1 and Synchronous RAM
    filesets_append :
      - sim_basic
    toplevel        : fifo_sync_tb
    parameters      :
      - SYNC_READ=true
      - DEPTH=1
    default_tool    : ghdl
    tools :
      ghdl :
        analyze_options : ["-Wall","-fsynopsys","-frelaxed","--no-vital-checks"]
        run_options     : ["--fst=dut.fst","--ieee-asserts=disable"]

#=========================================
scripts :
#=========================================

  #---------------------------------------
  # pre_run hook of lint_ghdl_synth_* (cwd = work_root)
  #---------------------------------------
  ghdl_synth :
    cmd : [bash, ghdl_synth.sh]

#=========================================
parameters :
#=========================================

  SYNC_READ :
    description : Synchronoys Read
    datatype    : bool
    default     : false
    paramtype   : generic

  DEPTH :
    description : FIFO depth (power of 2)
    datatype    : int
    default     : 16
    paramtype   : generic
